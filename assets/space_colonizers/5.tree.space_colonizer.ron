// Tree 5: palm tree.
// Strong gravity lean, thin tall trunk, crown fans out, coconuts + fronds.
(
    trunk_settings: (
        count: 1,
        root_pos: (0.0, 0.0, 0.0),
        branch_len: Value(5.0),
        initial_dir: Value((0.0, 1.0, 0.0)),
    ),
    build_steps: [
        // Strong lean for visible palm curve
        GrowDirection((
            times: Value(9),
            trunk_growth_direction: GravityLean(strength: 0.5),
            branch_len: Value(4.5),
        )),
        // Crown arm attractors: offset upward first to gain height at the crown
        SpawnAttractorOnBranches((
            selector: Tips,
            offset_distance: 4.0,
            offset_dir: WorldUp,
            shape: Cube((size_x: 14.0, size_y: 2.0, size_z: 14.0)),
            attractor_spacing: AttractorSpacing(attractor_spacing: 4.0, jitter_ratio: 0.9),
        )),
        GrowToAttractors((
            times: Value(2),
            branch_len: Value(4.5),
            kill_distance: 3.5,
            leaf_attraction_dist: 7.0,
        )),
        ClearAttractors,
        // Coconuts on the current crown arm tips
        SpawnLeaves((
            selector: Tips,
            shape: Sphere(radius: Value(1.8)),
            decoration: Single(VoxelMapping(name: "coconut")),
        )),
        // Frond attractors fanning out horizontally from crown tips
        SpawnAttractorOnBranches((
            selector: Tips,
            offset_distance: 4.0,
            offset_dir: BranchForwardFlat,
            shape: Cube((size_x: 16.0, size_y: 2.0, size_z: 16.0)),
            attractor_spacing: AttractorSpacing(attractor_spacing: 3.5, jitter_ratio: 1.0),
        )),
        GrowToAttractors((
            times: Value(3),
            branch_len: Value(3.0),
            kill_distance: 2.5,
            leaf_attraction_dist: 5.5,
        )),
        ClearAttractors,
        // Palm fronds on final tips — random direction arms for the fan effect
        SpawnLeaves((
            selector: Tips,
            shape: ConiferWhorl((
                max_branch_length: 9.0,
                max_branch_width: 1.5,
                branch_sharpness: 0.8,
                branch_thickness: 1,
                branch_droop: 0.35,
                tip_lift: 0.0,
                rotation_step: 2.39996,
                length_jitter_ratio: 0.15,
                taper: None,
                arm_facing: Random(max_pitch_degrees: 30.0),
            )),
            decoration: Gradient((
                axis: Y,
                modulation: Some(Random(percent_offset: 0.08)),
                steps: [
                    LeafGradientEntry(percent: 0.4,  voxel_mapping: VoxelMapping(name: "leaf_dark")),
                    LeafGradientEntry(percent: 0.75, voxel_mapping: VoxelMapping(name: "leaf_mid")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "leaf_bright")),
                ],
            )),
        )),
    ],
    bark_decorator: Single(VoxelMapping(name: "bark")),
    // Thin trunk tapering to nothing at crown
    branch_size_setting: Generation(sizes: [1.8, 1.2, 0.8]),
    branch_root_size_increaser: Some((height: 5.0, additional_size: 1.2)),
)
