// Tree 3: conifer where tips droop first then curl back upward (cedar style).
// Same structure as tree 2 but tip_lift bends arm ends back up.
(
    trunk_settings: (
        count: 1,
        root_pos: (0.0, 0.0, 0.0),
        branch_len: Value(4.0),
        initial_dir: Random(
            y_rotation_range: Range(0, 360),
            z_rotation_max: Range(0, 2),
        ),
    ),
    build_steps: [
        GrowDirection((
            times: Value(1),
            trunk_growth_direction: Normal,
            branch_len: Value(3.0),
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "leaf_dark")),
            filter: BranchFilter(
                ignore_root: false,
            ),
        )),
        SpawnLeaves((
            shape: StarLeaf((
                arm_length: Value(10.0),
                arm_width: 3.5,
                thickness: 2,
                branch_sharpness: 0.6,
                droop: 0.0,
                tip_lift: 7.0,
            )),
            decoration: Gradient((
                modulation: Some(Random(percent_offset: 0.08)),
                steps: [
                    LeafGradientEntry(percent: 0.55,  voxel_mapping: VoxelMapping(name: "leaf_dark")),
                    LeafGradientEntry(percent: 0.75, voxel_mapping: VoxelMapping(name: "leaf_mid")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "leaf_bright")),
                ],
            )),
        )),
        GrowDirection((
            times: Value(3),
            trunk_growth_direction: GravityLean(strength: 0.6),
            branch_len: Value(5.0),
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "leaf_dark")),
            filter: BranchFilter(
                ignore_shapes: false,
            ),
        )),
        SpawnLeaves((
            shape: StarLeaf((
                arm_length: Value(4.0),
                arm_width: 3.5,
                thickness: 2,
                branch_sharpness: 0.6,
                droop: 0.0,
                tip_lift: 3.0,
            )),
            filter: BranchFilter(
                iteration_filter: Last,
            ),
            decoration: Gradient((
                modulation: Some(Random(percent_offset: 0.08)),
                steps: [
                    LeafGradientEntry(percent: 0.55,  voxel_mapping: VoxelMapping(name: "bark_dark")),
                    LeafGradientEntry(percent: 0.75, voxel_mapping: VoxelMapping(name: "bark")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "bark_bright")),
                ],
            )),
        )),
    ],
)
