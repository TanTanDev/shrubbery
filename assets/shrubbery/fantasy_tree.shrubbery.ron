// Tree 4: weeping tree.
// Trunk curves hard with gravity. Sub-canopy pulled up from tips.
// Heavy droop whorls hang down from the sub-canopy branches.
(
    build_steps: [
        SpawnRootBranch((
            count: 1,
            pos: (0.0, 0.0, 0.0),
            branch_len: Value(4.0),
            initial_dir: Random(
                y_rotation_range: Range(0, 360),
                z_rotation_max: Range(3, 4),
            ),
        )),
        // Stronger gravity lean for a visible curve
        GrowDirection((
            assign_id: AssignId(1),
            times: Value(9),
            filter: BranchFilter(
                ignore_root: false,
                ignore_shapes: true,
                id_filter: All,
                // iteration_filter: All,
                iteration_filter: All,
            ),
            trunk_growth_direction: GravityLean(strength: 0.35),
            branch_len: Value(9.0),
            branch_thickness: IterationScale(
                min: Value(5.0),
                max: Value(1.0)
            ),
            decoration: Value(Gradient((
                sampling_method: IterationPercent,
                modulation: None,
                steps: [
                    LeafGradientEntry(percent: 0.4,  voxel_mapping: VoxelMapping(name: "bark_dark")),
                    LeafGradientEntry(percent: 0.55, voxel_mapping: VoxelMapping(name: "bark")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "bark_bright")),
                ],
            ))),
            // decoration: Single(VoxelMapping(name: "leaf_bright")),
        )),
        GrowDirection((
            times: Value(1),
            filter: BranchFilter(
                id_filter: All,
                iteration_filter: Greater(2),
            ),
            trunk_growth_direction: Target(Vec3(0,1,0)),
            branch_len: Value(9.0),
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Value(Solid(VoxelMapping(name: "bark"))),
        )),
        SpawnLeaves((
            shape: Sphere(radius: Range(3.0, 7.0)),
            decoration: Value(Gradient((
                modulation: Some(Random(percent_offset: 0.1)),
                steps: [
                    LeafGradientEntry(percent: 0.33, voxel_mapping: VoxelMapping(name: "leaf_dark")),
                    LeafGradientEntry(percent: 0.66, voxel_mapping: VoxelMapping(name: "leaf_mid")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "leaf_bright")),
                ],
            ))),
            filter: BranchFilter(
                ignore_shapes: true,
                id_filter: Last,
                iteration_filter: All,
            ),
        )),
        SpawnAttractorOnBranches((
            filter: BranchFilter(
                ignore_shapes: true,
                id_filter: Target(1),
                iteration_filter: All,
            ),
            offset_distance: 20.0,
            offset_dir: WorldDown,
            shape: Cube((size_x: 10.0, size_y: 1.0, size_z: 10.0)),
            attractor_spacing: AttractorSpacing(attractor_spacing: 5.0, jitter_ratio: 1.0),
        )),
        GrowToAttractors((
            times: Value(4),
            filter: BranchFilter(
                id_filter: Target(1),
                iteration_filter: Greater(4),
            ),
            branch_len: Value(8.0),
            kill_distance: 2.5,
            leaf_attraction_dist: 19.0,
            decoration: Value(Solid(VoxelMapping(name: "leaf_bright"))),
            branch_thickness: ValueOrRange(Value(1.0)),
        )),
        SpawnLeaves((
            shape: StarLeaf((
                arm_length: Value(3.0),
                arm_width: 2.5,
                thickness: 2,
                branch_sharpness: 0.6,
                droop: 0.9,
                tip_lift: 0.0,
            )),
            filter: BranchFilter(
                iteration_filter: Last,
            ),
            decoration: Value(Solid(VoxelMapping(name: "leaf_dark"))),
        )),
    ],
)
