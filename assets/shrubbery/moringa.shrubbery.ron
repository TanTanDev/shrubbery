(
    build_steps: [
        SpawnRootBranch((
            assign_id: AssignId(0),
            count: 1,
            pos: (0.0, 0.0, 0.0),
            branch_len: Value(2.0),
            initial_dir: Random(
                y_rotation_range: Range(0, 360),
                z_rotation_max: Range(0, 2),
            ),
        )),
        GrowDirection((
            times: Value(6),
            trunk_growth_direction: GravityLean(strength: 0.3),
            branch_len: Range(1.0,7.0),
            branch_thickness: IterationScale (
                min: Value(3.0),
                max: Value(1.0),
            ),
            decoration: Value(Solid(VoxelMapping(name: "bark"))),
            filter: BranchFilter(
                ignore_root: false,
            ),
        )),
        SpawnAttractorOnBranches((
            offset_distance: 3.0,
            offset_dir: WorldUp,
            shape: Cube((size_x: 30.0, size_y: 20.0, size_z: 30.0)),
            attractor_spacing: AttractorSpacing(attractor_spacing: 5.0, jitter_ratio: 1.0),
            filter: BranchFilter(
                iteration_filter: Last,
