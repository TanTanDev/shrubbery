// Tree 7: inverse-taper conifer — whorls grow larger toward the apex.
// Swapping min_y/max_y in Height taper inverts the size gradient.
// tip_lift > 0 curves arm tips upward.
(
    trunk_settings: (
        count: 1,
        root_pos: (0.0, 0.0, 0.0),
        branch_len: Value(4.0),
        initial_dir: Value((0.0, 1.0, 0.0)),
    ),
    build_steps: [
        GrowDirection((
            times: Value(7),
            trunk_growth_direction: Normal,
            branch_len: Value(4.0),
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "bark")),
            filter: BranchFilter(
                ignore_root: false,
            ),
        )),
        SpawnAttractor((
            pos: (0.0, 16.0, 0.0),
            shape: Cube((size_x: 12.0, size_y: 20.0, size_z: 12.0)),
            attractor_spacing: AttractorSpacing(attractor_spacing: 2.5, jitter_ratio: 0.7),
        )),
        GrowToAttractors((
            times: Value(5),
            branch_len: Value(3.5),
            kill_distance: 3.0,
            leaf_attraction_dist: 5.5,
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "bark")),
        )),
        SpawnLeaves((
            selector: Tips,
            shape: ConiferWhorl((
                max_branch_length: 9.0,
                max_branch_width: 2.0,
                branch_sharpness: 0.7,
                branch_thickness: 1,
                branch_droop: 0.0,
                tip_lift: 2.5,
                rotation_step: 2.39996,
                length_jitter_ratio: 0.15,
                // Swapped min/max: base is slim, apex is wide.
                taper: Height(min_y: 36.0, max_y: 0.0),
                arm_facing: Horizontal,
                whorl_spacing: 1.0,
            )),
            decoration: Gradient((
                modulation: Some(Random(percent_offset: 0.08)),
                steps: [
                    LeafGradientEntry(percent: 0.4,  voxel_mapping: VoxelMapping(name: "leaf_dark")),
                    LeafGradientEntry(percent: 0.75, voxel_mapping: VoxelMapping(name: "leaf_mid")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "leaf_bright")),
                ],
            )),
        )),
    ],
)
