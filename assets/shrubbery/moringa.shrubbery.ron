        )),
        SpawnLeaves((
            shape: StarLeaf((
                arm_length: Value(7.0),
                arm_width: 3.5,
                thickness: 1,
                branch_sharpness: 0.7,
                droop: 1.0,
                tip_lift: 0.0,
            )),
            filter: BranchFilter(
