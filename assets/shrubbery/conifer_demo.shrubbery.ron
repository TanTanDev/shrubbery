// Tree 2: classic upright conifer, whorls drooping down.
// Tight narrow attractor cone → layers taper from wide base to sharp apex.
(
    trunk_settings: (
        count: 1,
        root_pos: (0.0, 0.0, 0.0),
        branch_len: Value(4.0),
        initial_dir: Random(
            y_rotation_range: Range(0, 360),
            z_rotation_max: Range(20, 30),
        ),
    ),
    build_steps: [
        GrowDirection((
            times: Value(1),
            // trunk_growth_direction: Normal,
            trunk_growth_direction: GravityLean(strength: 0.2),
            branch_len: Value(16.5),
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "bark")),
        )),
        SpawnAttractor((
            pos: (0.0, 20.0, 0.0),
            // Narrow cone: wide at base, pinched at top
            shape: Cube((size_x: 8.0, size_y: 20.0, size_z: 8.0)),
            attractor_spacing: AttractorSpacing(attractor_spacing: 2.0, jitter_ratio: 0.6),
        )),
        GrowToAttractors((
            times: Value(1),
            branch_len: Value(1.0),
            kill_distance: 2.5,
            leaf_attraction_dist: 5.0,
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "bark")),
        )),
        SpawnLeaves((
            selector: Tips,
            shape: ConiferWhorl((
                max_branch_length: 16.0,
                max_branch_width: 3.5,
                branch_sharpness: 0.3,
                branch_thickness: 1,
                branch_droop: 0.4,
                tip_lift: 0.0,
                rotation_step: 2.39996,
                length_jitter_ratio: 0.00,
                taper: Height(min_y: 2.0, max_y: 46.0),
                arm_facing: Random(max_pitch_degrees: 999.0),
                whorl_spacing: 1.0,
                // arm_facing: Horizontal,
            )),
            decoration: Gradient((
                modulation: None,
                // modulation: Some(Random(percent_offset: 0.08)),
                steps: [
                    LeafGradientEntry(percent: 0.3,  voxel_mapping: VoxelMapping(name: "leaf_bright")),
                    LeafGradientEntry(percent: 0.4, voxel_mapping: VoxelMapping(name: "leaf_mid")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "leaf_dark")),
                ],
            )),
        )),
    ],
)
