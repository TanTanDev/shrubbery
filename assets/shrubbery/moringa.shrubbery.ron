        )),
        GrowToAttractors((
            times: Value(5),
            branch_len: Value(5.0),
            kill_distance: 5.0,
            leaf_attraction_dist: 8.0,
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Value(Solid(VoxelMapping(name: "bark"))),
            filter: BranchFilter(
                id_filter: Target(1),
