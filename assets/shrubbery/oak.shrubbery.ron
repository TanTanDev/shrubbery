// Oak tree — branching trunk, large sphere-leaf canopy.
// SpawnLeaves runs at the end so only the final tips get spheres.
(
    trunk_settings: (
        count: 1,
        root_pos: (0.0, 0.0, 0.0),
        branch_len: Value(5.0),
        initial_dir: Random(
            y_rotation_range: Range(0, 360),
            z_rotation_max: Range(2, 5),
        ),
    ),
    build_steps: [
        GrowDirection((
            times: Value(6),
            trunk_growth_direction: GravityLean(strength: 0.3),
            branch_len: Value(4.0),
            // branch_thickness: ValueOrRange(Value(1.0)),
            branch_thickness: IterationScale (
                min: Value(3.0),
                max: Value(1.0),
            ),
            decoration: Single(VoxelMapping(name: "bark")),
            filter: BranchFilter(
                ignore_root: false,
            ),
        )),
        SpawnAttractorOnBranches((
            offset_distance: 0.0,
            offset_dir: WorldDown,
            shape: Cube((size_x: 25.0, size_y: 20.0, size_z: 25.0)),
            attractor_spacing: AttractorSpacing(attractor_spacing: 2.0, jitter_ratio: 1.0),
            filter: BranchFilter(
                iteration_filter: Last,
            ),
        )),
        GrowToAttractors((
            times: Value(5),
            branch_len: Value(8.0),
            kill_distance: 5.0,
            leaf_attraction_dist: 6.0,
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "bark")),
        )),
        SpawnLeaves((
            selector: Tips,
            shape: Sphere(radius: Value(6.0)),
            decoration: Gradient((
                modulation: Some(Random(percent_offset: 0.1)),
                steps: [
                    LeafGradientEntry(percent: 0.33, voxel_mapping: VoxelMapping(name: "leaf_dark")),
                    LeafGradientEntry(percent: 0.66, voxel_mapping: VoxelMapping(name: "leaf_mid")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "leaf_bright")),
                ],
            )),
        )),
    ],
)
