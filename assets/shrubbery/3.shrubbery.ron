// Tree 3: conifer where tips droop first then curl back upward (cedar style).
// Same structure as tree 2 but tip_lift bends arm ends back up.
(
    trunk_settings: (
        count: 1,
        root_pos: (0.0, 0.0, 0.0),
        branch_len: Value(4.0),
        initial_dir: Random(
            y_rotation_range: Range(0, 360),
            z_rotation_max: Range(0, 4),
        ),
    ),
    build_steps: [
        GrowDirection((
            times: Value(10),
            trunk_growth_direction: Normal,
            // trunk_growth_direction: GravityLean(strength: 0.2),
            branch_len: Value(3.0),
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "bark")),
            filter: BranchFilter(
                ignore_root: false,
            ),
        )),
        SpawnLeaves((
            shape: ConiferWhorl((
                max_branch_length: 16.0,
                max_branch_width: 4.5,
                branch_sharpness: 0.2,
                branch_thickness: 1,
                branch_droop: 1.6,
                tip_lift: 14.9,
                rotation_step: 2.39996,
                length_jitter_ratio: 0.1,
                taper: Height(min_y: 9.0, max_y: 46.0),
                arm_facing: Horizontal,
            )),
            filter: BranchFilter(
                // id_filter: Target(0),
                iteration_filter: Greater(5),
                // iteration_filter: Greater(0),
            ),
            decoration: Gradient((
                axis: Y,
                modulation: Some(Random(percent_offset: 0.08)),
                steps: [
                    LeafGradientEntry(percent: 0.15,  voxel_mapping: VoxelMapping(name: "leaf_bright")),
                    LeafGradientEntry(percent: 0.25, voxel_mapping: VoxelMapping(name: "leaf_mid")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "leaf_dark")),
                ],
            )),
        )),
    ],
    bark_decorator: Single(VoxelMapping(name: "bark")),
    branch_size_setting: Generation(sizes: [1.0, 1.0]),
    // branch_root_size_increaser: Some((height: 2.0, additional_size: 1.5)),
    branch_root_size_increaser: None,
)
