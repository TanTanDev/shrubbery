// Tree 6: high-canopy oak — bare lower trunk, full canopy sphere leaves on top.
// MinHeight selector ensures only canopy-height tips get leaves.
(
    trunk_settings: (
        count: 1,
        root_pos: (0.0, 0.0, 0.0),
        branch_len: Value(5.0),
        initial_dir: Random(
            y_rotation_range: Range(0, 360),
            z_rotation_max: Range(1, 4),
        ),
    ),
    build_steps: [
        // Phase 1: tall straight trunk with short bare side-branches
        GrowDirection((
            times: Value(7),
            trunk_growth_direction: Normal,
            branch_len: Value(5.0),
            filter: BranchFilter(
                ignore_root: false,
            ),
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "bark_dark")),
        )),
        SpawnAttractor((
            pos: (0.0, 20.0, 0.0),
            shape: Cube((size_x: 10.0, size_y: 20.0, size_z: 10.0)),
            attractor_spacing: AttractorSpacing(attractor_spacing: 5.0, jitter_ratio: 0.9),
        )),
        GrowToAttractors((
            times: Value(2),
            branch_len: Range(3.0, 9.0),
            kill_distance: 3.0,
            leaf_attraction_dist: 8.0,
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "bark_dark")),
        )),
        // No SpawnLeaves — lower branches stay bare bark.
        ClearAttractors,

        // // Phase 2: wide canopy high up
        SpawnAttractor((
            pos: (0.0, 45.0, 0.0),
            shape: Cube((size_x: 34.0, size_y: 20.0, size_z: 34.0)),
            attractor_spacing: AttractorSpacing(attractor_spacing: 3.5, jitter_ratio: 1.0),
        )),
        GrowToAttractors((
            times: Value(9),
            branch_len: Value(3.0),
            kill_distance: 4.0,
            leaf_attraction_dist: 6.0,
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "bark_bright")),
        )),
        // // MinHeight targets only the canopy branches, not the lower ones
        SpawnLeaves((
            selector: MinHeight(28.0),
            shape: Sphere(radius: Value(5.0)),
            decoration: Gradient((
                modulation: Some(Random(percent_offset: 0.1)),
                steps: [
                    LeafGradientEntry(percent: 0.33, voxel_mapping: VoxelMapping(name: "leaf_dark")),
                    LeafGradientEntry(percent: 0.66, voxel_mapping: VoxelMapping(name: "leaf_mid")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "leaf_bright")),
                ],
            )),
            filter: BranchFilter(
                id_filter: Last,
                iteration_filter: All,
            ),
        )),
    ],
)
