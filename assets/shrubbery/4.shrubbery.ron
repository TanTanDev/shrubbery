// Tree 4: weeping tree.
// Trunk curves hard with gravity. Sub-canopy pulled up from tips.
// Heavy droop whorls hang down from the sub-canopy branches.
(
    trunk_settings: (
        count: 1,
        root_pos: (0.0, 0.0, 0.0),
        branch_len: Value(4.0),
        initial_dir: Random(
            y_rotation_range: Range(0, 360),
            z_rotation_max: Range(3, 4),
        ),
    ),
    build_steps: [
        // Stronger gravity lean for a visible curve
        GrowDirection((
            times: Value(9),
            filter: BranchFilter(
                ignore_root: false,
                ignore_shapes: true,
                id_filter: All,
                // iteration_filter: All,
                iteration_filter: All,
            ),
            trunk_growth_direction: GravityLean(strength: 0.35),
            branch_len: Value(9.0),
            branch_thickness: IterationScale(
                min: Value(5.0),
                max: Value(1.0)
            ),
            decoration: Gradient((
                sampling_method: IterationPercent,
                modulation: None,
                steps: [
                    LeafGradientEntry(percent: 0.4,  voxel_mapping: VoxelMapping(name: "bark_dark")),
                    LeafGradientEntry(percent: 0.55, voxel_mapping: VoxelMapping(name: "bark")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "bark_bright")),
                ],
            )),
            // decoration: Single(VoxelMapping(name: "leaf_bright")),
        )),
        // Spawn attractors straight up from trunk tip — pulls sub-branches upward
        SpawnAttractorOnBranches((
            // selector: MinHeight(6.0),
            // selector: Tips,
            offset_distance: 3.0,
            offset_dir: WorldUp,
            // shape: Cube((size_x: 10.0, size_y: 6.0, size_z: 10.0)),
            shape: Cube((size_x: 1.0, size_y: 1.0, size_z: 1.0)),
            attractor_spacing: AttractorSpacing(attractor_spacing: 1.0, jitter_ratio: 1.0),
            filter: BranchFilter(
                ignore_shapes: true,
                id_filter: Last,
                iteration_filter: All,
            ),
        )),
        GrowToAttractors((
            times: Value(1),
            iteration_calculation: Parent,
            branch_len: Range(8.0, 12.0),
            kill_distance: 2.5,
            leaf_attraction_dist: 8.0,
            decoration: Single(VoxelMapping(name: "bark")),
            // decoration: Single(VoxelMapping(name: "leaf_mid")),
            branch_thickness: ValueOrRange(Value(2.0)),
            filter: BranchFilter(
                ignore_shapes: true,
                id_filter: Last,
                // id_filter: AllGenerations,
                iteration_filter: Greater(2),
                // iteration_filter: Lower(9),
                // iteration_filter: All,
            ),
        )),
        ClearAttractors,
        SpawnLeaves((
            selector: Tips,
            shape: Sphere(radius: Range(2.0, 5.0)),
            decoration: Gradient((
                modulation: Some(Random(percent_offset: 0.1)),
                steps: [
                    LeafGradientEntry(percent: 0.33, voxel_mapping: VoxelMapping(name: "leaf_dark")),
                    LeafGradientEntry(percent: 0.66, voxel_mapping: VoxelMapping(name: "leaf_mid")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "leaf_bright")),
                ],
            )),
            filter: BranchFilter(
                ignore_shapes: true,
                id_filter: Last,
                iteration_filter: All,
            ),
        )),
        SpawnAttractorOnBranches((
            filter: BranchFilter(
                ignore_shapes: true,
                id_filter: Target(0),
                iteration_filter: All,
            ),
            offset_distance: 6.0,
            offset_dir: WorldDown,
            shape: Cube((size_x: 10.0, size_y: 1.0, size_z: 10.0)),
            attractor_spacing: AttractorSpacing(attractor_spacing: 5.0, jitter_ratio: 1.0),
        )),
        GrowToAttractors((
            times: Value(1),
            // iteration_calculation: Parent,
            filter: BranchFilter(
                ignore_shapes: false,
                id_filter: Target(0),
                iteration_filter: Greater(3),
                // iteration_filter: All,
            ),
            // branch_len: Range(4.0, 12.0),
            branch_len: Value(9.0),
            kill_distance: 2.5,
            leaf_attraction_dist: 6.0,
            decoration: Single(VoxelMapping(name: "leaf_bright")),
            branch_thickness: ValueOrRange(Value(1.0)),
        )),
    ],
)
