// Tree 2: classic upright conifer, whorls drooping down.
// Tight narrow attractor cone → layers taper from wide base to sharp apex.
(
    build_steps: [
        SpawnRootBranch((
            assign_id: AssignId(0),
            count: 1,
            pos: (0.0, 0.0, 0.0),
            branch_len: Value(4.0),
            initial_dir: Random(
                y_rotation_range: Range(0, 360),
                z_rotation_max: Range(1, 2),
            ),
        )),
        GrowDirection((
            times: Value(1),
            trunk_growth_direction: Normal,
            branch_len: Range(10.0, 25.0),
            branch_thickness: ValueOrRange(Value(3.0)),
            decoration: Value(Solid(VoxelMapping(name: "bark"))),
            filter: BranchFilter(
                ignore_root: false,
            ),
        )),
        GrowDirection((
            times: Value(1),
            trunk_growth_direction: Normal,
            branch_len: Range(50.0, 60.0),
            branch_thickness: IterationScale (
                min: Value(2.0),
                max: Value(1.0),
            ),
            decoration: Value(Solid(VoxelMapping(name: "bark"))),
        )),
        SpawnLeaves((
            shape: ConiferWhorl((
                max_branch_length: 19.0,
                max_branch_width: 8.5,
                branch_sharpness: 0.7,
                branch_thickness: 1,
                branch_droop: 0.6,
                tip_lift: 0.9,
                rotation_step: 2.39996,
                length_jitter_ratio: 0.15,
                taper: Height(min_y: 10.0, max_y: 76.0),
                arm_facing: Horizontal,
                whorl_spacing: 3.0,
            )),
            filter: BranchFilter(
                ignore_shapes: true,
                id_filter: Target(2),
            ),
            decoration: Value(Gradient((
                modulation: Some(Random(percent_offset: 0.08)),
                steps: [
                    LeafGradientEntry(percent: 0.4,  voxel_mapping: VoxelMapping(name: "leaf_dark")),
                    LeafGradientEntry(percent: 0.75, voxel_mapping: VoxelMapping(name: "leaf_mid")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "leaf_bright")),
                ],
            ))),
        )),
    ],
)
