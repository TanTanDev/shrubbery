// Tree 2: classic upright conifer, whorls drooping down.
// Tight narrow attractor cone → layers taper from wide base to sharp apex.
(
    trunk_settings: (
        count: 1,
        root_pos: (0.0, 0.0, 0.0),
        branch_len: Value(4.0),
        initial_dir: Random(
            y_rotation_range: Range(0, 360),
            z_rotation_max: Range(0, 2),
        ),
    ),
    build_steps: [
        GrowDirection((
            times: Value(1),
            trunk_growth_direction: GravityLean(strength: 0.6),
            branch_len: Value(8.0),
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "bark")),
            filter: BranchFilter(
                ignore_root: false,
            ),
        )),
        GrowDirection((
            times: Value(1),
            trunk_growth_direction: GravityLean(strength: 0.3),
            branch_len: Value(32.0),
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "bark")),
        )),
        SpawnLeaves((
            shape: ConiferWhorl((
                max_branch_length: 14.0,
                max_branch_width: 5.5,
                branch_sharpness: 0.7,
                branch_thickness: 1,
                branch_droop: 0.3,
                tip_lift: 0.0,
                rotation_step: 2.39996,
                length_jitter_ratio: 0.15,
                taper: Height(min_y: 10.0, max_y: 46.0),
                arm_facing: Horizontal,
                whorl_spacing: 1.7,
            )),
            filter: BranchFilter(
                id_filter: Target(2),
                // iteration_filter: Greater(0),
            ),
            decoration: Gradient((
                modulation: Some(Random(percent_offset: 0.01)),
                axis: Y,
                steps: [
                    LeafGradientEntry(percent: 0.4,  voxel_mapping: VoxelMapping(name: "leaf_bright")),
                    LeafGradientEntry(percent: 0.75, voxel_mapping: VoxelMapping(name: "leaf_mid")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "leaf_dark")),
                ],
            )),
        )),
        // SpawnLeaves((
        //     shape: ConiferWhorl((
        //         max_branch_length: 16.0,
        //         max_branch_width: 5.5,
        //         branch_sharpness: 0.6,
