// Tree 5: palm tree.
// Strong gravity lean, thin tall trunk, crown fans out, coconuts + fronds.
(
    trunk_settings: (
        count: 1,
        root_pos: (0.0, 0.0, 0.0),
        branch_len: Value(5.0),
        initial_dir: Random(
            y_rotation_range: Range(0, 360),
            z_rotation_max: Range(1, 7),
        ),
    ),
    build_steps: [
        // Strong lean for visible palm curve
        GrowDirection((
            times: Value(5),
            trunk_growth_direction: GravityLean(strength: 0.2),
            branch_len: Range(3.5, 4.5),
            branch_thickness: ValueOrRange(Value(2.0)),
            decoration: Single(VoxelMapping(name: "bark")),
            filter: BranchFilter(
                ignore_root: false,
            ),
            assign_id: AssignId(0),
        )),
        GrowDirection((
            times: Value(3),
            trunk_growth_direction: Normal,
            branch_len: Value(2.5),
            branch_thickness: ValueOrRange(Value(4.0)),
            decoration: Single(VoxelMapping(name: "bark_dark")),
            filter: BranchFilter(
                iteration_filter: Last,
            ),
            assign_id: AssignId(1),
        )),
        // coconut branches
        GrowRadial((
            count: Range(0,5),
            spacing_jitter: 0.5,
            pitch_degrees: Value(-50.0),
            trunk_growth_direction: Normal,
            branch_len: Value(7.0),
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "bark")),
            filter: BranchFilter(
                id_filter: Last,
                iteration_filter: Last,
            ),
            assign_id: AssignId(2),
        )),
        // coconut balls
        SpawnLeaves((
            shape: Sphere(radius: Value(2.0)),
            decoration: Single(VoxelMapping(name: "bark_bright")),
            filter: BranchFilter(
                id_filter: Target(2),
                iteration_filter: All,
            ),
        )),
        GrowRadial((
            count: Range(2,4),
            spacing_jitter: 1.0,
            pitch_degrees: Value(-10.0),
            trunk_growth_direction: Normal,
            branch_len: Value(7.0),
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "leaf_dark")),
            filter: BranchFilter(
                id_filter: Target(1),
                iteration_filter: Last,
            ),
        )),
        GrowRadial((
            count: Range(3, 5),
            spacing_jitter: 0.5,
            pitch_degrees: Value(40.0),
            trunk_growth_direction: Normal,
            branch_len: Value(6.0),
            branch_thickness: ValueOrRange(Value(1.0)),
            decoration: Single(VoxelMapping(name: "leaf_dark")),
            filter: BranchFilter(
                id_filter: Target(1),
                iteration_filter: Last,
            ),
        )),
        GrowDirection((
            times: Value(3),
            trunk_growth_direction: GravityLean(strength: 0.6),
            branch_len: Value(5.5),
            branch_thickness: ValueOrRange(Value(1.0)),
            // decoration: Single(VoxelMapping(name: "leaf_bright")),
            decoration: Gradient((
                axis: Y,
                modulation: Some(Random(percent_offset: 0.08)),
                steps: [
                    LeafGradientEntry(percent: 0.4,  voxel_mapping: VoxelMapping(name: "leaf_dark")),
                    LeafGradientEntry(percent: 0.65, voxel_mapping: VoxelMapping(name: "leaf_mid")),
                    LeafGradientEntry(percent: 1.0,  voxel_mapping: VoxelMapping(name: "leaf_bright")),
                ],
            )),
            filter: BranchFilter(
                ignore_root: false,
            ),
        )),
